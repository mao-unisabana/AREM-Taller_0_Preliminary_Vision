        <mxCell id="title1" value="TO-BE - Mapa de Tecnologia - Asul Tecnologias de la Informacion SAS" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1F3864;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="subtitle1" value="Extiende mapa-final.drawio (Fase 04). Elementos en verde = NUEVO (Taller 7). El resto es identico al AS-IS." style="text;html=1;fontSize=11;fontStyle=2;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="20" as="geometry"/></mxCell><mxCell id="bound_ws" value="Puestos de Trabajo - Equipo Asul" style="rounded=1;fillColor=none;strokeColor=#8c9bab;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#4a5568;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="300" as="geometry"/></mxCell><mxCell id="ws1" value="💻 Computadores propios
