sobre discos de backup [NUEVO]" style="endArrow=block;strokeColor=#2e7d32;strokeWidth=2;fontSize=9;fontColor=#1b5e20;fontStyle=1;labelBackgroundColor=#ffffff;html=1;" edge="1" parent="1" source="bk3" target="bk1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota1" value="Brechas que cierra este TO-BE: R4 (despliegue dependiente de Alejandro, Fase 04/05) via Azure Pipelines; brecha Alta de Normatividad (retencion indefinida de codigo, Fase 06) via la politica de retencion. La separacion de infraestructura entre clientes y el rezago del backup semanal de SharePoint quedan en el backlog (no priorizados en esta iteracion)." style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1230" height="50" as="geometry"/></mxCell><mxCell id="leg_title" value="Leyenda" style="text;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="200" height="20" as="geometry"/></mxCell><mxCell id="leg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg1t" value="Componente AS-IS (sin cambios)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="735" width="260" height="24" as="geometry"/></mxCell><mxCell id="leg2" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#6b6b6b;strokeColor=#4a4a4a;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="768" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg2t" value="Base de datos" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="768" width="260" height="24" as="geometry"/></mxCell><mxCell id="leg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="735" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg3t" value="✅ NUEVO (Taller 7)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="374" y="735" width="320" height="24" as="geometry"/></mxCell><mxCell id="leg4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c0392b;strokeColor=#7b1f1f;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="768" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg4t" value="⚠ Riesgo que sigue abierto (backlog)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="374" y="768" width="320" height="24" as="geometry"/></mxCell><mxCell id="leg5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4a017;strokeColor=#8a6a0f;fontColor=#ffffff;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="735" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg5t" value="Riesgo mitigado (reducido, no eliminado)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="734" y="735" width="320" height="24" as="geometry"/></mxCell>
